<?xml version="1.0" encoding="utf-8"?>
<!--
  UVC video only. Do NOT include USB Audio class 1 (would match headphones).
  Auto-launch intent was removed from the manifest so HDMI Link is not stolen.
  Pin VID/PID here after first dumpsys if a vendor-class card is not enumerated as class 14.
-->
<resources>
    <usb-device class="14" subclass="1" />
    <usb-device class="14" subclass="2" />
</resources>
